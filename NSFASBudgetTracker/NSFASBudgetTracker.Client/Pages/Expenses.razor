@page "/expenses"
@inject HttpClient Http
@inject IJSRuntime JS


<h3>Expenses</h3>

<EditForm Model="newExpense" OnValidSubmit="SaveExpense">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Description:</label>
        <InputText @bind-Value="newExpense.Description" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Amount (ZAR):</label>
        <InputNumber @bind-Value="newExpense.Amount" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Budget:</label>
        <InputSelect @bind-Value="newExpense.BudgetId" class="form-control">
            <option value="">-- Select Budget --</option>
            @foreach (var b in budgets)
            {
                <option value="@b.Id">@b.Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Category:</label>
        <InputSelect @bind-Value="newExpense.CategoryId" class="form-control">
            <option value="">-- Select Category --</option>
            @foreach (var c in categories)
            {
            <option value="@c.Id">@c.Name</option>
            }
        </InputSelect>
    </div>


    <button type="submit" class="btn btn-success">Add Expense</button>
</EditForm>

<hr />

@if (expenses == null)
{
    <p><em>Loading...</em></p>
}
else if (!expenses.Any())
{
    <p>No expenses found.</p>
}
else
{
    <ul class="list-group">
        @foreach (var e in expenses)
        {
            var budgetName = budgets.FirstOrDefault(b => b.Id == e.BudgetId)?.Name;
            var categoryName = categories.FirstOrDefault(c => c.Id == e.CategoryId)?.Name;

            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@e.Description</strong> - R@e.Amount
                    (Budget: @budgetName, Category: @categoryName)
                </div>
                <div>
                    <button class="btn btn-sm btn-secondary me-1" @onclick="() => EditExpense(e)">Edit</button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteExpense(e.Id)">Delete</button>
                </div>
            </li>
       }

    </ul>
}

@code {
    private List<Expense> expenses;
    private List<Budget> budgets;
    private List<Category> categories;
    private bool isEditing = false;
    private int editingExpenseId = 0;

    private Expense newExpense = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
        await LoadExpenses();
        await LoadCategories();
    }
    private void EditExpense(Expense e)
    {
            newExpense = new Expense
            {
                Id = e.Id,
                Description = e.Description,
                Amount = e.Amount,
                BudgetId = e.BudgetId,
                CategoryId = e.CategoryId
            };
            isEditing = true;
            editingExpenseId = e.Id;
   }
   private async Task DeleteExpense(int id)
   {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this expense?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/expense/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadExpenses();
        }
    }

    private async Task LoadBudgets()
    {
        budgets = await Http.GetFromJsonAsync<List<Budget>>("api/budget");
    }

    private async Task LoadExpenses()
    {
        expenses = await Http.GetFromJsonAsync<List<Expense>>("api/expense");
    }
    private async Task LoadCategories()
    {
        categories = await Http.GetFromJsonAsync<List<Category>>("api/category");
    }
    private async Task SaveExpense()
    {
        HttpResponseMessage response;

        if (isEditing)
        {
            response = await Http.PutAsJsonAsync($"api/expense/{newExpense.Id}", newExpense);
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/expense", newExpense);
        }

        if (response.IsSuccessStatusCode)
        {
            newExpense = new Expense();
            isEditing = false;
            editingExpenseId = 0;
            await LoadExpenses();
        }
        else
        {
            // Handle error
        }
    }

    public class Expense
    {public int Id { get; set; }
    public string Description { get; set; }
    public decimal Amount { get; set; }
    public int BudgetId { get; set; }
    public int CategoryId { get; set; }
    }

    public class Budget
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }

    public class Category
    {
        public int Id { get; set; }
        public string Name { get; set; }
    }

}
